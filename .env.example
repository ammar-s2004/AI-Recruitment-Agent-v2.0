# PUBLIC VARIABLES SAFE TO EXPOSE TO THE BROWSER
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# PRIVATE VARIABLES - DO NOT EXPOSE TO THE BROWSER
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# AI Services
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key

# Tavus & Voice Configuration
TAVUS_API_KEY=your_tavus_api_key
NEXT_PUBLIC_VOICE_ID_MANAV=your_voice_id
NEXT_PUBLIC_TAVUS_REPLICA_ID=your_replica_id

# Auth
NEXTAUTH_SECRET=a_long_random_secret_string_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
